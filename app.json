{
  "expo": {
    "name": "picks-app",
    "slug": "picks-app",
    "version": "1.1.0",
    "scheme": "picks",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fass216.picksapp",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fass216.picksapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "06059259-c03f-47f0-8658-605cf298974c"
      }
    },
    "owner": "fass216",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/06059259-c03f-47f0-8658-605cf298974c"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Picks necesita acceso a tu galería para buscar productos con una foto o captura de pantalla y para cambiar tu foto de perfil.",
          "cameraPermission": "Picks necesita acceso a tu cámara para buscar productos con una foto y para tu foto de perfil."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Picks necesita acceso al micrófono para buscar por voz.",
          "speechRecognitionPermission": "Picks necesita reconocimiento de voz para buscar por voz.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ]
    ]
  }
}
